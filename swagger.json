{
  "swagger": "2.0",
  "info": {
    "title": "Users API",
    "description": "API for managing contacts and activities",
    "version": "1.0.0"
  },
  "host": "cse341-project-2-fn1v.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
    "/users/": {
      "get": {
        "tags": ["Contacts"],
        "description": "Get all contacts",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "description": "Create a new contact",
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Contact object to create",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "age": { "type": "integer" },
                "cityAddress": { "type": "string" },
                "favoriteColor": { "type": "string" }
              },
              "required": ["firstName", "lastName", "email"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Contact created successfully" },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "msg": { "type": "string" },
                      "param": { "type": "string" },
                      "location": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Contacts"],
        "description": "Get a single contact by ID",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Contact not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "tags": ["Contacts"],
        "description": "Update an existing contact",
        "consumes": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "description": "Contact object to update",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "age": { "type": "integer" },
                "cityAddress": { "type": "string" },
                "favoriteColor": { "type": "string" }
              },
              "required": ["firstName", "lastName", "email"]
            }
          }
        ],
        "responses": {
          "204": { "description": "Contact updated successfully" },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "msg": { "type": "string" },
                      "param": { "type": "string" },
                      "location": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Contact not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "description": "Delete a contact by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "Contact deleted successfully" },
          "404": { "description": "Contact not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/activities/": {
      "get": {
        "tags": ["Activities"],
        "description": "Get all activities",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Activities"],
        "description": "Create a new activity",
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Activity object to create",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "date": { "type": "string", "format": "date" },
                "time": { "type": "string", "format": "time" },
                "participants": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["title"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Activity created successfully" },
          "400": { "description": "Validation error" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/activities/{id}": {
      "get": {
        "tags": ["Activities"],
        "description": "Get a single activity by ID",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Activity not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "tags": ["Activities"],
        "description": "Update an existing activity",
        "consumes": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "description": "Activity object to update",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "date": { "type": "string", "format": "date" },
                "time": { "type": "string", "format": "time" },
                "participants": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["title"]
            }
          }
        ],
        "responses": {
          "204": { "description": "Activity updated successfully" },
          "400": { "description": "Validation error" },
          "404": { "description": "Activity not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "tags": ["Activities"],
        "description": "Delete an activity by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "Activity deleted successfully" },
          "404": { "description": "Activity not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}
