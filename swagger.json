{
  "swagger": "2.0",
  "info": {
    "title": "Movie Review API",
    "description": "API for Movies, Genres, Users and Reviews",
    "version": "1.0.0"
  },
  "host": "https://cse341-final-project-cuyn.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
   
    "/movies": {
      "get": {
        "tags": ["Movies"],
        "description": "Get all movies",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Movies retrieved" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Movies"],
        "description": "Create a new movie",
        "parameters": [
          {
            "in": "body",
            "name": "movie",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "year": { "type": "integer" },
                "director": { "type": "string" },
                "genre": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "key-words": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["title", "year"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Movie created" },
          "400": { "description": "Validation Error" }
        }
      }
    },

    "/movies/{id}": {
      "get": {
        "tags": ["Movies"],
        "description": "Get movie by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Movie found" },
          "404": { "description": "Movie not found" }
        }
      },
      "put": {
        "tags": ["Movies"],
        "description": "Update movie",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "movie",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "year": { "type": "integer" },
                "director": { "type": "string" },
                "genre": { "type": "array", "items": { "type": "string" } },
                "key-words": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        ],
        "responses": {
          "204": { "description": "Updated successfully" },
          "404": { "description": "Movie not found" }
        }
      },
      "delete": {
        "tags": ["Movies"],
        "description": "Delete movie by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "Movie deleted" },
          "404": { "description": "Movie not found" }
        }
      }
    },

    "/genres": {
      "get": {
        "tags": ["Genres"],
        "description": "Get all genres",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Genres"],
        "description": "Create new genre",
        "parameters": [
          {
            "in": "body",
            "name": "genre",
            "required": true,
            "schema": {
              "type": "object",
              "properties": { "name": { "type": "string" } },
              "required": ["name"]
            }
          }
        ],
        "responses": { "201": { "description": "Genre created" } }
      }
    },

    "/genres/{id}": {
      "get": {
        "tags": ["Genres"],
        "description": "Get genre by ID",
        "parameters": [
          { "name": "id", "in": "path", "type": "string", "required": true }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "tags": ["Genres"],
        "description": "Update genre",
        "parameters": [
          { "name": "id", "in": "path", "type": "string", "required": true },
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": { "name": { "type": "string" } }
            }
          }
        ],
        "responses": { "204": { "description": "Updated" } }
      },
      "delete": {
        "tags": ["Genres"],
        "parameters": [{ "name": "id", "in": "path", "required": true }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },

    
    "/users": {
      "get": {
        "tags": ["Users"],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Users"],
        "description": "Create user",
        "parameters": [
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "userId": { "type": "number" },
                "username": { "type": "string" },
                "email": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "User created" } }
      }
    },

    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "parameters": [{ "name": "id", "in": "path", "type": "string" }],
        "responses": { "200": { "description": "User found" } }
      },
      "put": {
        "tags": ["Users"],
        "parameters": [
          { "name": "id", "in": "path", "type": "string" },
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "username": { "type": "string" },
                "email": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        ],
        "responses": { "204": { "description": "Updated" } }
      },
      "delete": {
        "tags": ["Users"],
        "parameters": [{ "name": "id", "in": "path" }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },


    "/reviews": {
      "get": {
        "tags": ["Reviews"],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Reviews"],
        "parameters": [
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "movieTitle": { "type": "string" },
                "username": { "type": "string" },
                "shortReview": { "type": "string" },
                "rating": { "type": "number" },
                "wouldRecommend": { "type": "boolean" },
                "favorite": { "type": "boolean" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Review added" } }
      }
    },

    "/reviews/{id}": {
      "get": {
        "tags": ["Reviews"],
        "parameters": [{ "name": "id", "in": "path" }]
      },
      "put": {
        "tags": ["Reviews"],
        "parameters": [
          { "name": "id", "in": "path" },
          { "in": "body", "schema": { "type": "object" } }
        ],
        "responses": { "204": { "description": "Updated" } }
      },
      "delete": {
        "tags": ["Reviews"],
        "parameters": [{ "name": "id", "in": "path" }],
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  }
}
