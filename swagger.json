{
  "swagger": "2.0",
  "info": {
    "title": "Movie Review API",
    "description": "API for managing Movies, Genres, Users, and Reviews. Supports CRUD operations for each resource and allows users to submit reviews for movies.",
    "version": "1.0.0"
  },
  "host": "cse341-final-project-cuyn.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  
  "paths": {
    "/movies": {
      "get": {
        "tags": ["Movies"],
        "description": "Get all movies",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Movies retrieved" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Movies"],
        "description": "Create a new movie",
        "parameters": [
          {
            "in": "body",
            "name": "movie",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "year": { "type": "integer", "minimum": 1888 },
                "director": { "type": "string", "minLength": 1 },
                "genre": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "key-words": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["title", "year"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Movie created" },
          "400": { "description": "Validation Error" }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": ["Movies"],
        "description": "Get movie by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Movie found" },
          "404": { "description": "Movie not found" }
        }
      },
      "put": {
        "tags": ["Movies"],
        "description": "Update movie",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "movie",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "year": { "type": "integer", "minimum": 1888 },
                "director": { "type": "string", "minLength": 1 },
                "genre": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "key-words": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        ],
        "responses": {
          "204": { "description": "Updated successfully" },
          "404": { "description": "Movie not found" }
        }
      },
      "delete": {
        "tags": ["Movies"],
        "description": "Delete movie by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "Movie deleted" },
          "404": { "description": "Movie not found" }
        }
      }
    },
    "/genres": {
      "get": {
        "tags": ["Genres"],
        "description": "Get all genres",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Genres"],
        "description": "Create new genre",
        "parameters": [
          {
            "in": "body",
            "name": "genre",
            "required": true,
            "schema": {
              "type": "object",
              "properties": { "name": { "type": "string", "minLength": 1 } },
              "required": ["name"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Genre created" },
          "400": { "description": "Validation Error" }
        }
      }
    },
    "/genres/{id}": {
      "get": {
        "tags": ["Genres"],
        "description": "Get genre by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "tags": ["Genres"],
        "description": "Update genre",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": { "name": { "type": "string", "minLength": 1 } },
              "required": ["name"]
            }
          }
        ],
        "responses": {
          "204": { "description": "Updated" },
          "400": { "description": "Validation Error" }
        }
      },
      "delete": {
        "tags": ["Genres"],
        "parameters": [{ "name": "id", "in": "path", "required": true }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Users"],
        "description": "Create user",
        "parameters": [
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "userId": { "type": "integer", "minimum": 1 },
                "username": { "type": "string", "minLength": 3 },
                "email": { "type": "string", "format": "email" },
                "password": { "type": "string", "minLength": 6 }
              },
              "required": ["username", "email", "password"]
            }
          }
        ],
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation Error" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "User found" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "tags": ["Users"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "username": { "type": "string", "minLength": 3 },
                "email": { "type": "string", "format": "email" },
                "password": { "type": "string", "minLength": 6 }
              }
            }
          }
        ],
        "responses": {
          "204": { "description": "Updated" },
          "400": { "description": "Validation Error" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "parameters": [{ "name": "id", "in": "path", "required": true }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/reviews": {
      "get": {
        "tags": ["Reviews"],
        "description": "Get all reviews",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Reviews"],
        "description": "Create new review",
        "parameters": [
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "movieTitle": { "type": "string", "minLength": 1 },
                "username": { "type": "string", "minLength": 1 },
                "shortReview": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "rating": { "type": "number", "minimum": 0, "maximum": 10 },
                "wouldRecommend": { "type": "boolean" },
                "favorite": { "type": "boolean" }
              },
              "required": ["movieTitle", "username", "shortReview", "rating"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Review added" },
          "400": { "description": "Validation Error" }
        }
      }
    },
    "/reviews/{id}": {
      "get": {
        "tags": ["Reviews"],
        "description": "Get review by id",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Review found" },
          "404": { "description": "Review not found" }
        }
      },
      "put": {
        "tags": ["Reviews"],
        "description": "Update review info",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "movieTitle": { "type": "string", "minLength": 1 },
                "username": { "type": "string", "minLength": 1 },
                "shortReview": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "rating": { "type": "number", "minimum": 0, "maximum": 10 },
                "wouldRecommend": { "type": "boolean" },
                "favorite": { "type": "boolean" }
              }
            }
          }
        ],
        "responses": {
          "204": { "description": "Updated" },
          "400": { "description": "Validation Error" }
        }
      },
      "delete": {
        "tags": ["Reviews"],
        "description": "Delete Review by id",
        "parameters": [{ "name": "id", "in": "path", "required": true }],
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  }
}
